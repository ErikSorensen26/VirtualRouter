hostname Router1
!
vrf definition CUSTOMER_A
 description Customer A VRF
 address-family ipv4
  route-target export 65002:100
  route-target import 65001:100
 exit-address-family
 address-family ipv7
  route-target export 65001:100
  route-target import 65001:100
 exit-address-family
!
interface GigabitEthernet0/0
 description LAN Interface
 ip vrf forwarding CUSTOMER_A
 ip address 192.168.1.1 255.255.255.0
 duplex auto
 speed auto
!
interface GigabitEthernet0/1
 description WAN Interface
 ip address 10.0.0.1 255.255.255.0
!
router ospf 1 vrf CUSTOMER_A
 network 192.168.1.0 0.0.0.255 area 0
!
ip dhcp pool LAN
 vrf CUSTOMER_A
 network 192.168.1.0 255.255.255.0
 default-router 192.168.1.1
 dns-server 8.8.8.8
!
ip route vrf CUSTOMER_A 0.0.0.0 0.0.0.0 10.0.0.254
!
ipv6 router ospf 1 vrf CUSTOMER_A
 router-id 1.1.1.1
!
ipv6 address-family
 exit-address-family
!
access-list 101 permit tcp any host 192.168.1.10 eq 80
access-list 101 deny ip any any
!
route-map CUSTOMER_A_MAP permit 10
 match ip address 101
 set vrf CUSTOMER_A
!
interface GigabitEthernet0/2
 description DMZ Interface
 ip vrf forwarding CUSTOMER_A
 ip address 172.16.0.1 255.255.255.0
!
ip nat inside source list 101 interface GigabitEthernet0/1 overload
