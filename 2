    /**
     * @brief Represents a fully functional DHCP server
     * Cabable of managing IP address leases, handling dhcp packets, and supporting relay agents.
     */
    class DhcpServer {
    public:
        DhcpServer(Global& global, TimeManager& timeManager);
        ~DhcpServer();

        void start();
        void stop();

        void handlePacket(const DhcpHeader& dhcp, const uint8_t* sourceMac, Interface& iface);

        std::optional<Dhcp::DhcpNetwork*> getNetwork(IPPrefix& config);

        void scheduleTimeout(Dhcp::TimerType type, const ClientID, uint32_t timeout);
        void cancelTimeout(Dhcp::TimerType type, const ClientID& clientID, const IPAddress& offer);
        void clearOfferTimeouts();

    private:
        Global& global;
        TimeManager& timeManager;
        Dhcp::Configs config;

        std::mutex serverMutex;

        std::unordered_map<IPPrefix, Dhcp::DhcpNetwork> networks;
        std::unordered_map<uint32_t, ClientID> ipToClient;
        std::unordered_map<ClientID, std::chrono::steady_clock::time_point> declined;
        std::unordered_map<ClientID, std::chrono::steady_clock::time_point> forceRenew;

        std::unordered_map<ClientID, uint32_t> offeredIPs;
        std::unordered_map<uint32_t, Dhcp::SnoopingEntry> snoopingTable;

        // Timed event tracking
        std::unordered_map<uint32_t, uint32_t> offerTimeouts;
        std::unordered_map<uint32_t, uint32_t> declineTimers;
        std::unordered_map<uint32_t, uint32_t> forceRenewTimers;
        std::unordered_map<uint32_t, uint32_t> cleanupTimers;

        void addNetwork(IPPrefix& prefix);
        void removeNetwork(IPPrefix& prefix);
        bool removeConfig(IPPrefix& prefix);

        // === PACKET LOGIC ===
        void processDiscover(const DhcpHeader& dhcp, std::vector<TLV8Option>& options, Interface& iface);
        void processRequest(const DhcpHeader& dhcp, std::vector<TLV8Option>& options, Interface& iface);
        void processDecline(const DhcpHeader& dhcp, std::vector<TLV8Option>& options, Interface& iface);
        void processRelease(const DhcpHeader& dhcp, std::vector<TLV8Option>& options, Interface& iface);
        void processInform(const DhcpHeader& dhcp, std::vector<TLV8Option>& options, Interface& iface);
        void processForceRenew(const DhcpHeader& dhcp, std::vector<TLV8Option>& options, Interface& iface);

        // === PACKET SENDING ===
        void sendOffer(Interface& iface, uint32_t transID, const ClientID& client, const uint8_t* chaddr, uint32_t ip);
        void sendAck(Interface& iface, uint32_t transID, const ClientID& client, const uint8_t* chaddr, uint32_t ip);
        void sendNak(Interface& iface, uint32_t transID, const ClientID& client, const uint8_t* chaddr);
        void sendInformReply(Interface& iface, uint32_t transID, const ClientID& client, const uint8_t* chaddr);
        void sendForceRenew(Interface& iface, uint32_t transID, const ClientID& client, const uint8_t* chaddr);

        // === TIMER-BASED TASKS ===
        void expireOffer(uint32_t ip);
        void cleanupBinding(uint32_t ip);
        void clearDecline(uint32_t ip);
        void clearForceRenew(uint32_t ip);

        // === ENFORCEMENT ===
        bool enforceTrust(const Interface& iface, const ClientID& client, const Dhcp::Configs& config);
        bool verifySnooping(const Interface& iface, const ClientID& client, const Dhcp::Configs& config);
        void applyDNSRules(std::vector<IPAddress>& dnsOut, const Dhcp::Configs::DNS& dnsCfg);
        void applyOptionRules(std::vector<uint8_t>& optOut, const Dhcp::Configs& config);

        Dhcp::DhcpNetwork* matchingNetwork(const Interface& iface, const DhcpHeader& dhcp);
    };
}

#endif // DHCP_SERVER_H
